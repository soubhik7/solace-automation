# Solace Cloud Automation — Environment Variables
# ------------------------------------------------
# Copy this file to .env.local (gitignored) and fill in your values.
# Or set via CLI: python3 solace.py context set-token --token <token>
#
# This file must NOT contain real credentials — it is a template only.

# Required — Solace Cloud API Bearer token
export SOLACE_API_TOKEN="<your-solace-api-token>"

# Auto-populated by: python3 solace.py service use <service-id>
# You can also set manually:
export SEMP_BASE_URL=""      # e.g. https://mr-connection-xxx.messaging.solace.cloud:943/SEMP/v2/config
export SEMP_USERNAME=""      # e.g. mission-control-manager
export SEMP_PASSWORD=""
