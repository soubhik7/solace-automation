# Copy to .env and source it, or export variables directly.
#
# Required
export SOLACE_API_TOKEN="eyJ..."      # Solace Cloud API token

# Auto-populated by: python solace.py service use <service-id>
# You can also set them manually:
export SEMP_BASE_URL=""               # e.g. https://mr-connection-xxx.messaging.solace.cloud:943/SEMP/v2/config
export SEMP_USERNAME=""               # e.g. msgvpn-xxx-admin
export SEMP_PASSWORD=""
