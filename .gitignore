# ── Secrets & context ─────────────────────────────────────────────────────────
.solace-context.json        # persisted token + SEMP creds (never commit)
.env                        # local environment overrides

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/
*.egg
.Python

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# ── Test / clone artifacts ────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
*.log

# Clone output dirs — generated by 'provision clone' / 'provision replicate'
# Add your real country configs explicitly (git add config/sg/service.json)
# and leave test artifacts here so they aren't committed accidentally.
config/au/
config/de/
config/sg/
config/jp/
config/us/
config/uk/
